# Copy to .env.local and fill in. Never commit real keys.

# --- AI model: LangChain's LangSmith LLM Gateway (default) ---
# Uses LANGSMITH_API_KEY below. Needs Gateway Credits in LangSmith, OR the gateway
# enabled + your OpenAI key saved as a LangSmith workspace secret.
 AIGUIDEN_MODEL=moonshotai/Kimi-K2.6     # hosted (credits). Or: openai/gpt-4.1-mini (your OpenAI secret)
 LANGSMITH_GATEWAY_URL=https://gateway.smith.langchain.com/v1

# --- Or call a provider directly (set AIGUIDEN_PROVIDER to use it while LANGSMITH_API_KEY is set) ---
# AIGUIDEN_PROVIDER=openai
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# Or any OpenAI-compatible endpoint (Groq, OpenRouter, Together, Ollama):
# AIGUIDEN_PROVIDER=compatible
# AIGUIDEN_BASE_URL=https://api.groq.com/openai/v1
# AIGUIDEN_API_KEY=
# AIGUIDEN_MODEL=llama-3.3-70b-versatile

# Free keyless model (Pollinations.ai) answers when nothing else is set up or the main model fails.
# AIGUIDEN_FREE_MODEL=false       # turn it off

# Optional overrides
# AIGUIDEN_PROVIDER=langsmith     # langsmith | openai | anthropic | google | compatible
# AIGUIDEN_MODEL=gpt-5-mini       # defaults: gpt-5-mini, claude-haiku-5-5, gemini-2.5-flash
# AIGUIDEN_TEMPERATURE=0.4
# AIGUIDEN_RATE_LIMIT=20          # messages per minute per IP

# --- LangSmith: tracing + the gateway key ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=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
LANGSMITH_PROJECT=aiguiden

# --- Optional: live web search tool (tavily.com) ---
# TAVILY_API_KEY=
